<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/accountScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/color_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/screen_padding_horizontal"
        android:paddingRight="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/screen_padding_top"
        android:paddingBottom="@dimen/screen_padding_bottom">

        <TextView
            android:id="@+id/messageView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/section_gap"
            android:background="@drawable/bg_message_error"
            android:padding="@dimen/group_padding_compact"
            android:textAppearance="@style/TextAppearance.Estoque.Error"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/signedInSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Conta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_surface"
                android:padding="@dimen/group_padding">

                <TextView
                    android:id="@+id/accountEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Estoque.Section" />

                <TextView
                    android:id="@+id/accountWorkspace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Estoque.Body"
                    android:textColor="@color/color_text" />

                <TextView
                    android:id="@+id/accountRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Estoque.Caption" />

                <Button
                    android:id="@+id/verifyEmailButton"
                    style="@style/Widget.Estoque.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    android:text="Confirmar e-mail" />
            </LinearLayout>

            <!-- Nuvem -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:orientation="vertical"
                android:background="@drawable/bg_surface"
                android:padding="@dimen/group_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Nuvem"
                        android:textAppearance="@style/TextAppearance.Estoque.Section" />

                    <TextView
                        android:id="@+id/cloudBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:background="@drawable/bg_type_badge"
                        android:textAppearance="@style/TextAppearance.Estoque.Caption"
                        android:textColor="@color/color_text_on_brand"
                        android:textStyle="bold"
                        android:text="Ativa" />
                </LinearLayout>

                <TextView
                    android:id="@+id/accountSubscription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/field_gap"
                    android:textAppearance="@style/TextAppearance.Estoque.Body.Muted" />

                <TextView
                    android:id="@+id/planUsage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextAppearance.Estoque.Label"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/planProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/color_brand"
                    android:progressBackgroundTint="@color/color_border"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Última sincronização"
                            android:textAppearance="@style/TextAppearance.Estoque.Caption" />

                        <TextView
                            android:id="@+id/accountLastSync"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/color_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Aguardando envio"
                            android:textAppearance="@style/TextAppearance.Estoque.Caption" />

                        <TextView
                            android:id="@+id/accountPending"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/color_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/syncStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextAppearance.Estoque.Supporting"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/syncNowButton"
                    style="@style/Widget.Estoque.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Sincronizar agora" />

                <Button
                    android:id="@+id/conflictsButton"
                    style="@style/Widget.Estoque.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/field_gap"
                    android:visibility="gone"
                    android:text="Resolver conflitos" />
            </LinearLayout>

            <!-- Plano e equipe -->
            <LinearLayout
                android:id="@+id/planCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:orientation="vertical"
                android:background="@drawable/bg_surface"
                android:padding="@dimen/group_padding">

                <TextView
                    android:id="@+id/planTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Plano gratuito"
                    android:textAppearance="@style/TextAppearance.Estoque.Section" />

                <TextView
                    android:id="@+id/planDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/field_gap"
                    android:textAppearance="@style/TextAppearance.Estoque.Body.Muted" />

                <Button
                    android:id="@+id/subscriptionButton"
                    style="@style/Widget.Estoque.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Conhecer o plano Equipe" />

                <Button
                    android:id="@+id/teamButton"
                    style="@style/Widget.Estoque.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/field_gap"
                    android:text="Equipe" />
            </LinearLayout>

            <Button
                android:id="@+id/diagnosticsButton"
                style="@style/Widget.Estoque.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:text="Verificar dados do aparelho" />

            <Button
                android:id="@+id/logoutButton"
                style="@style/Widget.Estoque.Button.Destructive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/field_gap"
                android:text="Sair da conta" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.Estoque.Supporting"
                android:text="Sair da conta não apaga nada deste aparelho. Seus produtos e o histórico continuam disponíveis normalmente." />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/signedOutSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seu estoque na nuvem, de graça"
                android:textAppearance="@style/TextAppearance.Estoque.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"
                android:textAppearance="@style/TextAppearance.Estoque.Supporting"
                android:text="Crie uma conta e seus produtos ficam guardados na nuvem: troque de aparelho ou use mais de um sem perder nada. Para trabalhar em equipe, existe o plano Equipe. Sem conta, o app continua funcionando normalmente neste aparelho." />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/nameLayout"
                style="@style/Widget.Estoque.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Seu nome"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/nameField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:autofillHints="name" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/emailLayout"
                style="@style/Widget.Estoque.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/field_gap"
                android:hint="E-mail">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/emailField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:autofillHints="emailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/passwordLayout"
                style="@style/Widget.Estoque.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/field_gap"
                android:hint="Senha"
                app:endIconMode="password_toggle"
                app:endIconContentDescription="Mostrar ou ocultar senha">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/passwordField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLength="200"
                    android:autofillHints="password" />
            </com.google.android.material.textfield.TextInputLayout>

            <include
                layout="@layout/password_rules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <CheckBox
                android:id="@+id/rememberLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Lembrar meus dados"
                android:textColor="@color/color_text" />

            <Button
                android:id="@+id/primaryButton"
                style="@style/Widget.Estoque.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Entrar" />

            <Button
                android:id="@+id/toggleModeButton"
                style="@style/Widget.Estoque.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Ainda não tenho conta" />

            <TextView
                android:id="@+id/legalNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textAppearance="@style/TextAppearance.Estoque.Caption"
                android:gravity="center"
                android:visibility="gone" />

        </LinearLayout>

        <Button
            android:id="@+id/inviteCodeButton"
            style="@style/Widget.Estoque.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:text="Recebi um convite" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
