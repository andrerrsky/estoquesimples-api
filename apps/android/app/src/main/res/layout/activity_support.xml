<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/color_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="@dimen/screen_padding_horizontal"
        android:paddingRight="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/screen_padding_top"
        android:paddingBottom="@dimen/screen_padding_bottom">

        <LinearLayout
            android:id="@+id/faqEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/section_gap"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_surface"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/group_padding_compact"
            android:paddingEnd="@dimen/field_gap"
            android:paddingTop="@dimen/row_gap"
            android:paddingBottom="@dimen/row_gap"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Perguntas frequentes"
                    android:textAppearance="@style/TextAppearance.Estoque.Body"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Veja se a sua dúvida já tem resposta"
                    android:textAppearance="@style/TextAppearance.Estoque.Caption" />
            </LinearLayout>

            <!-- A mesma seta das linhas que expandem, deitada: aqui ela leva a outra tela. -->
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:rotation="-90"
                android:src="@drawable/ic_expand_more"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Precisa de ajuda?"
            android:textAppearance="@style/TextAppearance.Estoque.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.Estoque.Supporting"
            android:text="Conte o que aconteceu ou tire uma dúvida. Respondemos por aqui e você recebe uma notificação." />

        <Button
            android:id="@+id/newTicketButton"
            style="@style/Widget.Estoque.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Nova solicitação" />

        <TextView
            android:id="@+id/messageView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.Estoque.Error"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:textAppearance="@style/TextAppearance.Estoque.Empty"
            android:visibility="gone"
            android:text="Você ainda não abriu nenhuma solicitação." />

        <TextView
            android:id="@+id/listTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:text="Suas solicitações"
            android:textAppearance="@style/TextAppearance.Estoque.Section"
            android:visibility="gone" />

        <ListView
            android:id="@+id/ticketList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/field_gap"
            android:divider="@color/color_border"
            android:dividerHeight="@dimen/stroke_width"
            android:clipToPadding="false" />
    </LinearLayout>
</LinearLayout>
