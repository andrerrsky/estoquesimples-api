<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de navegação das seções principais. A mesma barra aparece em
     Início, Histórico, Relatórios e Imp/Exp, com o item da seção atual
     marcado — antes só a Início tinha a barra, e as outras abriam como
     telas de detalhe com seta de voltar. -->
<com.google.android.material.bottomnavigation.BottomNavigationView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavigation"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_nav"
    app:elevation="0dp"
    app:menu="@menu/bottom_navigation_menu"
    app:itemIconTint="@color/bottom_navigation_selector"
    app:itemTextColor="@color/bottom_navigation_selector"
    app:labelVisibilityMode="labeled" />
