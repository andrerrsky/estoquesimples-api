<?xml version="1.0" encoding="utf-8"?>
<!-- Backup na nuvem e transferência entre aparelhos (Android 12+): mesmas
     regras de backup_rules.xml (só o banco "estoque"; as preferências
     cifradas ficam de fora por não estarem incluídas). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="estoque" />
        <include domain="database" path="estoque-wal" />
        <include domain="database" path="estoque-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="estoque" />
        <include domain="database" path="estoque-wal" />
        <include domain="database" path="estoque-shm" />
    </device-transfer>
</data-extraction-rules>
