<?xml version="1.0" encoding="utf-8"?>
<!-- Backup do Android (até o 11). Só o estoque local (banco "estoque") entra:
     é o que permite recuperar um aparelho perdido mesmo sem conta na nuvem.
     Com <include>, todo o resto fica de fora, inclusive sessão, login lembrado
     e direitos do plano: são cifrados com uma chave do Keystore que não viaja
     para outro aparelho (restaurados, não abririam) e não devem sair do
     aparelho de qualquer forma. Um <exclude> deles seria redundante (e o lint
     o recusa: FullBackupContent). -->
<full-backup-content>
    <include domain="database" path="estoque" />
    <include domain="database" path="estoque-wal" />
    <include domain="database" path="estoque-shm" />
</full-backup-content>
