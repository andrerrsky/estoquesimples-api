{
  "name": "estoquesimples",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo do Estoque Simples: API, painel administrativo, aplicação web e app Android.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/api",
    "apps/admin",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @estoquesimples/api",
    "dev:admin": "npm run dev --workspace @estoquesimples/admin",
    "dev:web": "npm run dev --workspace @estoquesimples/web",
    "build": "npm run build --workspace @estoquesimples/api && npm run build --workspace @estoquesimples/admin && npm run build --workspace @estoquesimples/web",
    "build:api": "npm run build --workspace @estoquesimples/api",
    "start": "node apps/api/dist/index.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @estoquesimples/api",
    "migrate": "npm run migrate --workspace @estoquesimples/api",
    "migrate:down": "npm run migrate:down --workspace @estoquesimples/api",
    "migrate:status": "npm run migrate:status --workspace @estoquesimples/api",
    "seed:dev": "npm run seed:dev --workspace @estoquesimples/api",
    "admin:create": "npm run admin:create --workspace @estoquesimples/api --",
    "keys:generate": "npm run keys:generate --workspace @estoquesimples/api",
    "openapi": "npm run --silent openapi --workspace @estoquesimples/api",
    "legal:sync": "npm run sync -w @estoquesimples/legal",
    "legal:check": "npm run check -w @estoquesimples/legal",
    "help:sync": "npm run sync -w @estoquesimples/help",
    "help:check": "npm run check -w @estoquesimples/help"
  }
}
