<resources>

    <!-- Tema de partida: só existe para a splash screen nativa (API do Android
         12+, com compatibilidade retroativa via core-splashscreen). Assim que
         installSplashScreen() roda, a Activity troca para CustomActionBarTheme. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/color_brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/CustomActionBarTheme</item>
    </style>

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.DarkActionBar.Bridge">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/color_surface</item>
        <item name="colorControlActivated">@color/color_brand</item>
        <item name="colorControlNormal">@color/color_text_muted</item>
        <item name="viewInflaterClass">androidx.appcompat.app.AppCompatViewInflater</item>
    </style>

    <style name="CustomActionBarTheme" parent="Theme.MaterialComponents.Light.DarkActionBar.Bridge">
        <item name="android:actionBarStyle">@style/MyActionBar</item>
        <item name="actionBarStyle">@style/MyActionBar</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/color_surface</item>
        <item name="colorControlActivated">@color/color_brand</item>
        <item name="colorControlNormal">@color/color_text_muted</item>
        <item name="android:textColorPrimary">@color/color_text</item>
        <item name="android:textColorSecondary">@color/color_text_muted</item>
        <item name="buttonStyle">@style/Widget.Estoque.Button.Primary</item>
        <item name="android:buttonStyle">@style/Widget.Estoque.Button.Primary</item>
        <item name="materialButtonStyle">@style/Widget.Estoque.Button.Primary</item>
        <item name="alertDialogTheme">@style/Theme.Estoque.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Estoque.Dialog</item>
        <item name="textInputStyle">@style/Widget.Estoque.TextInputLayout</item>
        <!-- Evita que o Material Components troque Button por MaterialButton. -->
        <item name="viewInflaterClass">androidx.appcompat.app.AppCompatViewInflater</item>
        <!-- Cores das barras em APIs anteriores ao edge-to-edge obrigatório.
             Em Android 15+/targetSdk 36 o tratamento fica em EdgeToEdgeHelper. -->
        <item name="android:statusBarColor">@color/system_bar</item>
        <item name="android:navigationBarColor">@color/system_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="MyActionBar" parent="@style/Widget.AppCompat.Light.ActionBar.Solid.Inverse">
        <item name="android:background">@color/colorActionBar</item>
        <item name="background">@color/colorActionBar</item>
    </style>

    <style name="Theme.Estoque.Dialog" parent="Theme.MaterialComponents.Light.Dialog.Alert.Bridge">
        <item name="colorAccent">@color/color_brand</item>
        <item name="colorPrimary">@color/color_brand</item>
        <item name="android:textColorPrimary">@color/color_text</item>
        <item name="android:windowBackground">@color/color_surface_content</item>
        <item name="textInputStyle">@style/Widget.Estoque.TextInputLayout</item>
        <item name="viewInflaterClass">androidx.appcompat.app.AppCompatViewInflater</item>
    </style>

    <!-- Tipografia -->
    <style name="TextAppearance.Estoque" parent="@android:style/TextAppearance">
        <item name="android:textColor">@color/color_text</item>
    </style>

    <style name="TextAppearance.Estoque.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_text</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.Estoque.Title.OnBrand">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_text_on_brand</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.Estoque.Section">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_text</item>
    </style>

    <style name="TextAppearance.Estoque.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/color_text</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.Estoque.Body.Muted">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/color_text_muted</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.Estoque.Supporting">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_text_muted</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.Estoque.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/color_text_muted</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.Estoque.Label">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_brand</item>
    </style>

    <style name="TextAppearance.Estoque.Error">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_error</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.Estoque.Warning">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_warning</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.Estoque.Value">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_success</item>
    </style>

    <style name="TextAppearance.Estoque.Empty">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/color_text_muted</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Botões -->
    <style name="Widget.Estoque" parent="@android:style/Widget" />

    <style name="Widget.Estoque.Button" parent="Widget.AppCompat.Button" />

    <style name="Widget.Estoque.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.Estoque.Button.Secondary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical_secondary</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical_secondary</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.Estoque.Button.Secondary.Compact">
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="Widget.Estoque.Button.Text" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.Estoque.Button.Destructive" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_danger_outline</item>
        <item name="android:textColor">@color/button_destructive_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical_secondary</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical_secondary</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.Estoque.Button.OnBrand" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_on_brand</item>
        <item name="android:textColor">@color/color_brand</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">@dimen/button_padding_vertical_secondary</item>
        <item name="android:paddingBottom">@dimen/button_padding_vertical_secondary</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.Estoque.Button.Icon" parent="Widget.Estoque.Button.Secondary">
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="Widget.Estoque.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="hintTextColor">@color/color_brand</item>
        <item name="android:textColorHint">@color/color_text_muted</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_button</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_button</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_button</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_button</item>
        <item name="boxStrokeWidth">@dimen/stroke_width</item>
        <item name="boxStrokeWidthFocused">@dimen/stroke_width_button</item>
    </style>

    <style name="Widget.Estoque.SearchView" parent="Widget.AppCompat.SearchView">
        <item name="android:background">@drawable/bg_search</item>
        <item name="queryHint">Buscar produtos...</item>
        <item name="iconifiedByDefault">false</item>
        <item name="queryBackground">@android:color/transparent</item>
        <item name="submitBackground">@android:color/transparent</item>
        <item name="android:paddingStart">@dimen/search_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/search_padding_horizontal</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>

</resources>
