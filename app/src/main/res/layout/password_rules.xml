<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/passwordRules"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A senha precisa:"
        android:textAppearance="@style/TextAppearance.Estoque.Supporting"
        android:textStyle="bold"
        android:textColor="@color/color_text_muted" />

    <TextView
        android:id="@+id/ruleLength"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="@style/TextAppearance.Estoque.Supporting"
        android:text="○  Pelo menos 10 caracteres" />

    <TextView
        android:id="@+id/ruleCommon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.Estoque.Supporting"
        android:text="○  Diferente de senhas óbvias" />

    <TextView
        android:id="@+id/ruleRepeated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.Estoque.Supporting"
        android:text="○  Não é o mesmo caractere repetido" />

    <TextView
        android:id="@+id/ruleEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.Estoque.Supporting"
        android:text="○  Não contém o seu e-mail" />

</LinearLayout>
