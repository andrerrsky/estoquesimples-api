<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@color/color_surface">

    <LinearLayout
        android:id="@+id/historyFilterBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/screen_padding_horizontal"
        android:paddingRight="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/field_gap"
        android:paddingBottom="@dimen/field_gap">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/historySearchView"
            style="@style/Widget.Estoque.SearchView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:iconifiedByDefault="false"
            app:queryHint="Buscar por produto..."
            app:queryBackground="@android:color/transparent"
            app:submitBackground="@android:color/transparent" />

        <Spinner
            android:id="@+id/historyTypeFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/field_gap"
            android:minWidth="110dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/emptyHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Nenhuma movimentação de entrada ou saída registrada ainda"
        android:textAppearance="@style/TextAppearance.Estoque.Empty"
        android:gravity="center"
        android:visibility="gone"
        android:padding="24dp" />

    <ListView
        android:id="@+id/historyList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="@dimen/list_item_spacing"
        android:paddingLeft="@dimen/screen_padding_horizontal"
        android:paddingRight="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/field_gap"
        android:paddingBottom="@dimen/field_gap"
        android:clipToPadding="false" />

    <include layout="@layout/include_bottom_nav" />

</LinearLayout>
