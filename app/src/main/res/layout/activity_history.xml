<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@color/color_surface">

    <TextView
        android:id="@+id/emptyHistory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="Nenhuma movimentação de entrada ou saída registrada ainda"
        android:textAppearance="@style/TextAppearance.Estoque.Empty"
        android:gravity="center"
        android:visibility="gone"
        android:padding="24dp" />

    <ListView
        android:id="@+id/historyList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@android:color/transparent"
        android:dividerHeight="@dimen/list_item_spacing"
        android:paddingLeft="@dimen/screen_padding_horizontal"
        android:paddingRight="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/field_gap"
        android:paddingBottom="@dimen/field_gap"
        android:clipToPadding="false" />

</LinearLayout>
