<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"

    tools:context="br.com.gameloop.estoquesimples.ImportActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingBottom="@dimen/activity_vertical_margin" >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:text="Importar um arquivo de outra aplicação"
            android:id="@+id/importFileTitle"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginLeft="16dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:text="Você pode importar arquivos com a seguinte estrutura:"
            android:id="@+id/importDesc1"
            android:gravity="center_horizontal"
            android:textAlignment="center"
            android:layout_centerHorizontal="true"
            android:layout_below="@+id/importFileTitle"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:text="Nome, Descrição, Quantidade, Valor (separados por virgula simples)\nSendo 1 item por linha\nFormatos .txt ou .csv"
            android:id="@+id/importDesc2"
            android:layout_below="@+id/importDesc1"
            android:layout_centerHorizontal="true"
            android:gravity="center_horizontal"
            android:layout_marginTop="16dp" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selecionar Arquivo"
            android:id="@+id/buttonImport"
            android:layout_below="@+id/importDesc2"
            android:layout_centerHorizontal="true"
            android:onClick="importFile"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:id="@+id/importStatus"
            android:layout_below="@+id/buttonImport"
            android:layout_centerHorizontal="true"
            android:textStyle="bold"
            android:layout_margin="16dp"
            android:gravity="center_horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:text="Importar ou exportar um banco de dados existente"
            android:id="@+id/importExportTitle"
            android:layout_below="@+id/buttonImport"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:textStyle="bold"
            android:layout_marginRight="26dp"
            android:layout_marginLeft="26dp"
            android:gravity="center"
            android:textAlignment="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:text="Você pode importar ou exportar um banco de dados existente.\n\nRecomendamos que você exporte e salve seu banco de dados sempre que possível para não perder as informações armazenadas.\n\n• Exportar Banco de Dados: Backup completo (arquivo .db)\n• Exportar para CSV/TXT: Planilha com todos os dados dos produtos (arquivo .csv)"
            android:id="@+id/importExportDesc"
            android:layout_below="@+id/importExportTitle"
            android:layout_centerHorizontal="true"
            android:gravity="center_horizontal"
            android:layout_marginLeft="26dp"
            android:layout_marginRight="26dp"
            android:layout_marginTop="16dp" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Importar Banco de Dados"
            android:id="@+id/buttonImportDB"
            android:layout_below="@+id/importExportDesc"
            android:layout_centerHorizontal="true"
            android:onClick="importDBFile"
            android:layout_marginTop="6dp" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exportar Banco de Dados"
            android:id="@+id/buttonExportDB"
            android:layout_below="@+id/buttonImportDB"
            android:layout_centerHorizontal="true"
            android:onClick="exportDBFile"
            android:layout_marginBottom="8dp" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exportar para CSV/TXT"
            android:id="@+id/buttonExportCSV"
            android:layout_below="@+id/buttonExportDB"
            android:layout_centerHorizontal="true"
            android:onClick="exportCSVFile"
            android:layout_marginBottom="16dp" />

        <!-- MREC Ad -->
        <FrameLayout
            android:id="@+id/mrecContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/buttonExportCSV"
            android:layout_centerHorizontal="true"
            android:visibility="visible">

            <com.appodeal.ads.MrecView
                android:id="@+id/appodealMrecView"
                android:layout_width="300dp"
                android:layout_height="250dp"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

        </FrameLayout>

    </RelativeLayout>

</ScrollView>