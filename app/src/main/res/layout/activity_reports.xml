<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F5F5F5"
    tools:context="br.com.gameloop.estoquesimples.ReportsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingBottom="@dimen/activity_vertical_margin">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:text="Relatórios e Estatísticas"
            android:id="@+id/reportsTitle"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Banner Ad -->
        <FrameLayout
            android:id="@+id/bannerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="visible">

            <com.appodeal.ads.BannerView
                android:id="@+id/appodealBannerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

        </FrameLayout>

        <!-- Botão Relatório Completo -->
        <Button
            android:id="@+id/btnExportPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_btn_complete"
            android:textColor="#FFFFFF"
            android:background="@color/colorActionBar"
            android:padding="14dp"
            android:layout_marginBottom="12dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:elevation="4dp" />

        <!-- Outros Relatórios -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/report_section_others"
            android:textStyle="bold"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnReportMovements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_btn_movements"
            android:textColor="#FFFFFF"
            android:background="@color/colorActionBar2"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:elevation="2dp" />

        <Button
            android:id="@+id/btnReportExits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_btn_exits"
            android:textColor="#FFFFFF"
            android:background="@color/colorActionBar2"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:elevation="2dp" />

        <Button
            android:id="@+id/btnReportEntries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_btn_entries"
            android:textColor="#FFFFFF"
            android:background="@color/colorActionBar2"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:elevation="2dp" />

        <Button
            android:id="@+id/btnReportLowStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_btn_low_stock"
            android:textColor="#FFFFFF"
            android:background="@color/colorActionBar2"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:elevation="2dp" />

        <Button
            android:id="@+id/btnReportCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_btn_category"
            android:textColor="#FFFFFF"
            android:background="@color/colorActionBar2"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:elevation="2dp" />

        <Button
            android:id="@+id/btnReportFinancial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_btn_financial"
            android:textColor="#FFFFFF"
            android:background="@color/colorActionBar2"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:elevation="2dp" />

        <!-- Cards de Estatísticas Resumidas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resumo Geral"
            android:textStyle="bold"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="Total de Produtos: 0"
                android:id="@+id/totalProducts"
                android:textColor="#333333"
                android:textSize="14sp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="Total de Itens: 0"
                android:id="@+id/totalItems"
                android:textColor="#333333"
                android:textSize="14sp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="Valor Total: $ 0,00"
                android:id="@+id/totalValue"
                android:textColor="#4CAF50"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="Valor Médio: $ 0,00"
                android:id="@+id/averageValue"
                android:textColor="#333333"
                android:textSize="14sp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

        </LinearLayout>

        <!-- Valor Total de Entradas e Saídas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/totalEntryValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="Valor Total de Entradas: $ 0,00"
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/totalExitValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="Valor Total de Saídas: $ 0,00"
                android:textColor="#FF5722"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

        </LinearLayout>

        <!-- Distribuição de Quantidade -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Distribuição de Quantidade"
            android:textStyle="bold"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

        <!-- Análise de Estoque -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Análise de Estoque"
            android:textStyle="bold"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text="Sem informações no momento."
                android:id="@+id/higher"
                android:textColor="#333333"
                android:textSize="14sp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text=""
                android:id="@+id/lower"
                android:textColor="#333333"
                android:textSize="14sp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <View
                android:id="@+id/dividerLowStock"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text=""
                android:id="@+id/lowStockWarning"
                android:textColor="#FF5722"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text=""
                android:id="@+id/lowStockList"
                android:textColor="#666666"
                android:textSize="13sp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Categorias (se houver) -->
        <TextView
            android:id="@+id/categoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Produtos por Categoria"
            android:textStyle="bold"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/categorySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:text=""
                android:id="@+id/categoriesList"
                android:textColor="#333333"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- MREC Ad -->
        <FrameLayout
            android:id="@+id/mrecContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="visible">

            <com.appodeal.ads.MrecView
                android:id="@+id/appodealMrecView"
                android:layout_width="300dp"
                android:layout_height="250dp"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

        </FrameLayout>

    </LinearLayout>

</ScrollView>
