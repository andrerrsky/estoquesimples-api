<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Estado atual: aparece quando já existe uma conta neste aparelho -->
        <LinearLayout
            android:id="@+id/signedInSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/accountEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#212121" />

            <TextView
                android:id="@+id/accountWorkspace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="15sp"
                android:textColor="#616161" />

            <TextView
                android:id="@+id/syncStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="14sp"
                android:textColor="#424242"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/syncNowButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Sincronizar agora" />

            <Button
                android:id="@+id/conflictsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:text="Resolver conflitos" />

            <Button
                android:id="@+id/teamButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:text="Equipe" />

            <Button
                android:id="@+id/subscriptionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:text="Assinatura" />

            <Button
                android:id="@+id/diagnosticsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Verificar dados do aparelho" />

            <Button
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Sair da conta" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="13sp"
                android:textColor="#757575"
                android:text="Sair da conta não apaga nada deste aparelho. Seus produtos e o histórico continuam disponíveis normalmente." />

        </LinearLayout>

        <!-- Entrada e cadastro -->
        <LinearLayout
            android:id="@+id/signedOutSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sincronizar na nuvem"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#212121" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"
                android:textSize="14sp"
                android:textColor="#616161"
                android:lineSpacingExtra="3dp"
                android:text="Com uma conta, seu estoque fica guardado na nuvem e disponível em outros aparelhos. O app continua funcionando sem internet: tudo é salvo aqui primeiro e enviado quando a conexão voltar." />

            <EditText
                android:id="@+id/nameField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Seu nome"
                android:inputType="textPersonName"
                android:autofillHints="name"
                android:visibility="gone" />

            <EditText
                android:id="@+id/emailField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="E-mail"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/passwordLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Senha"
                app:endIconMode="password_toggle"
                app:endIconContentDescription="Mostrar ou ocultar senha">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/passwordField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLength="200"
                    android:autofillHints="password" />

            </com.google.android.material.textfield.TextInputLayout>

            <include
                layout="@layout/password_rules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/primaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Entrar" />

            <Button
                android:id="@+id/toggleModeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@android:color/transparent"
                android:textColor="#1976D2"
                android:text="Ainda não tenho conta" />

        </LinearLayout>

        <!-- Fora das duas seções: um convite pode chegar tanto para quem
             ainda não tem conta quanto para quem já usa o app em outra
             empresa. -->
        <Button
            android:id="@+id/inviteCodeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@android:color/transparent"
            android:textColor="#1976D2"
            android:text="Recebi um convite" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/messageView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            android:textColor="#C62828"
            android:lineSpacingExtra="3dp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
