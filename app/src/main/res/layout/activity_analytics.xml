<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"

    android:background="#F5F5F5"
    tools:context="br.com.gameloop.estoquesimples.AnalyticsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Banner Ad -->
        <FrameLayout
            android:id="@+id/bannerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible">

            <com.appodeal.ads.BannerView
                android:id="@+id/appodealBannerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

        </FrameLayout>

        <!-- Content Layout (visible when premium) -->
        <LinearLayout
            android:id="@+id/analyticsContentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:visibility="gone">

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:text="📊 Análise de Estoque"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Análises preditivas baseadas no histórico de movimentações dos últimos 90 dias"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="24dp" />

            <!-- Container para cards de análise -->
            <LinearLayout
                android:id="@+id/analyticsCardsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Cards serão adicionados dinamicamente aqui -->
            </LinearLayout>

        </LinearLayout>

        <!-- Locked Layout (visible when NOT premium) -->
        <LinearLayout
            android:id="@+id/analyticsLockedLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingTop="32dp"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:visibility="gone"
            android:gravity="center">

            <!-- Ícone de bloqueio -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒"
                android:textSize="72sp"
                android:layout_marginBottom="24dp"
                android:layout_gravity="center" />

            <!-- Mensagem de bloqueio -->
            <TextView
                android:id="@+id/tvAnalyticsLockedMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔒 Recurso Exclusivo Premium"
                android:textSize="16sp"
                android:textColor="#333333"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="32dp" />

            <!-- Botão Tornar-se PRO -->
            <Button
                android:id="@+id/btnGoProFromAnalytics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⭐ Tornar-se PRO"
                android:textColor="#FFFFFF"
                android:background="@color/colorActionBar"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:elevation="4dp" />

            <!-- Botão Assistir Vídeo -->
            <Button
                android:id="@+id/btnWatchAdForAnalytics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎬 Assistir Vídeo - 1 Hora Grátis"
                android:textColor="#FFFFFF"
                android:background="#4CAF50"
                android:padding="16dp"
                android:layout_marginBottom="24dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:elevation="4dp" />

            <!-- Benefícios detalhados -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#FFFFFF">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨ O que você ganhará:"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 Previsão de esgotamento de estoque por produto"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="8dp"
                        android:drawablePadding="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📈 Taxa de rotatividade e velocidade de movimento"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="8dp"
                        android:drawablePadding="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 Recomendações inteligentes de reabastecimento"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="8dp"
                        android:drawablePadding="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ Identificação de produtos de alto e baixo giro"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginBottom="8dp"
                        android:drawablePadding="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📉 Análise de tendências de consumo"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:drawablePadding="8dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Nota sobre dados -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ️ As análises são baseadas no histórico de entradas e saídas registradas no aplicativo."
                android:textSize="12sp"
                android:textColor="#999999"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:padding="12dp"
                android:background="#F0F0F0" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>

