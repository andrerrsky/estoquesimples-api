# Copie para .env e ajuste. NUNCA versione o .env real.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# Banco. Em desenvolvimento use o docker-compose deste repositório.
DATABASE_URL=postgres://estoque:estoque@localhost:5433/estoquesimples
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Chaves Ed25519 para assinar o JWT. Gere com: npm run keys:generate
# Obrigatórias em staging e produção. Em desenvolvimento, se ausentes,
# uma chave efêmera é criada a cada boot (tokens não sobrevivem a restart).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=k1
JWT_ISSUER=estoquesimples-api
JWT_AUDIENCE=estoquesimples-app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# Vazio = nenhuma origem de browser liberada (o cliente é um app nativo).
CORS_ORIGINS=
BODY_LIMIT_BYTES=1048576
SYNC_BODY_LIMIT_BYTES=5242880

RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_BASE_SECONDS=60
LOGIN_LOCK_MAX_SECONDS=3600

PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=48
INVITE_TTL_DAYS=7

SYNC_PROTOCOL_VERSION=1
SYNC_PROTOCOL_MIN_SUPPORTED=1
SYNC_MAX_BATCH_ITEMS=500
SYNC_DEFAULT_PAGE_SIZE=500
# Prazo antes de a limpeza remover operações já processadas e lápides que todos
# os aparelhos já leram.
SYNC_OPERATION_RETENTION_DAYS=30
SYNC_RETENTION_INTERVAL_MINUTES=720
TOMBSTONE_RETENTION_DAYS=180
ENTITLEMENT_OFFLINE_MAX_DAYS=7

# Google Play. Deixe GOOGLE_SERVICE_ACCOUNT_JSON vazio para desabilitar a
# validação real de assinatura (a API sobe normalmente sem billing).
GOOGLE_PLAY_PACKAGE_NAME=br.com.gameloop.estoquesimples
GOOGLE_SERVICE_ACCOUNT_JSON=
# Obrigatório em staging/produção. Sem ele o webhook do Play fica fechado.
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
BILLING_RECONCILE_INTERVAL_MINUTES=360

# Provedor de e-mail. `log` só em development/test.
# Em staging/produção use `resend` (https://resend.com/api-keys).
EMAIL_PROVIDER=log
EMAIL_FROM=noreply@seudominio.com
RESEND_API_KEY=

# AES-256 (32 bytes em base64) para cifrar purchase tokens no banco.
# Obrigatória em staging/produção. Gere com: openssl rand -base64 32
PURCHASE_TOKEN_ENCRYPTION_KEY=

# Botão de emergência: desliga a sincronização sem exigir novo release Android.
FEATURE_SYNC_ENABLED=true
FEATURE_SYNC_MIN_APP_VERSION_CODE=0

JOBS_ENABLED=true

# Operação e observabilidade
# Gere com: openssl rand -base64 32
OPS_TOKEN=
OPS_WATCHDOG_INTERVAL_MINUTES=15
BACKUP_MAX_AGE_HOURS=48
